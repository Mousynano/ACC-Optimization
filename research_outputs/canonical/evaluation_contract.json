{
  "protocol": {
    "protocol_version": "RQ-2026-10-09-canonical-v1",
    "frozen_training_framework": "2.2-FJE",
    "research_questions": {
      "RQ1": "Under one fixed ACC tuning formulation, how do the six optimizers differ in solution quality, inter-run consistency, convergence, and computational cost?",
      "RQ2": "To what extent do optimization differences appear in cruise and following responses, including profiles withheld from tuning?",
      "RQ3": "How do fixed-gain performance, recovery, safety, and energy indicators change across the predeclared 12 physical-parameter conditions under matched road-load compensation?",
      "RQ4": "With the optimizer and tuning protocol fixed, how does including jerk and positive tractive-energy terms change the optimized gains and evaluated controller behavior?"
    },
    "permissions": {
      "all_controller_evaluation": true,
      "objective_ablation": true,
      "bounded_recovery_diagnostic": true,
      "sensor_uncertainty_campaign": false,
      "sensor_filtering": false,
      "separate_sensor_sampling": false,
      "compensation_parameter_mismatch": false,
      "equal_FE_campaign": false,
      "actuator_extension_campaign": false
    },
    "evaluation": {
      "controller_scope": "all completed runs; strict coverage by default",
      "unit_of_replication": "controller",
      "bootstrap_resamples": 2000,
      "correlation_permutations": 1999,
      "correlation_policy": "within optimizer and within profile; exploratory, not causal",
      "ttc_reporting_threshold_s": 1.5,
      "nominal_sensor_noise_std_m": 0.0,
      "nominal_sensor_bias_m": 0.0,
      "default_actuator": "instantaneous symmetric force limit, unchanged production plant",
      "primary_RQ3_scope": "12 declared physical conditions; all 180 fixed-gain controllers; matched actual/compensation parameters",
      "excluded_from_primary_study": [
        "sensor noise and bias perturbation campaign",
        "separate sensor sampling clock",
        "explicit sensor filtering",
        "actual-versus-nominal compensation mismatch"
